{
  "iterations": 150,
  "hpwl_direction": { "epsilon": 125.0, "active_power": 4.0, "degree_limit": 32 },
  "net_batch": { "weight": 1.0, "degree_limit": 32 },
  "optimizer": { "name": "amsgrad", "learning_rate": 0.002, "maximum_delta": 0.25, "beta1": 0.90, "beta2": 0.99 },
  "lambda": {
    "policy": "trajectory",
    "density_weight_scale": 1.0,
    "update_interval": 2,
    "trajectory_horizon": 150,
    "stop_overflow": 0.07
  },
  "selector": { "mode": "lowest_hpwl_under_overflow_cap", "overflow_cap": 0.07 },
  "log_every": 1,
  "adaptive_epsilon": false
}

